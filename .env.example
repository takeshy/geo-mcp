PORT=8080
# Leave empty locally to keep /mcp open; set it to require Authorization: Bearer <key>
MCP_API_KEY=
CORS_ORIGIN=*

# Optional local Docker Compose / PostGIS (not required by Cloud Run)
GEO_DOMAIN=geo.example.com
POSTGRES_PASSWORD=
DATABASE_URL=
LOCAL_COVERAGE_FILE=config/coverage.json
LOCAL_OSRM_CAR_URL=
LOCAL_OSRM_FOOT_URL=
LOCAL_OSRM_BIKE_URL=
EXTERNAL_NOMINATIM_URL=https://nominatim.openstreetmap.org
EXTERNAL_OVERPASS_URL=https://overpass-api.de/api/interpreter
EXTERNAL_OSRM_CAR_URL=https://router.project-osrm.org
EXTERNAL_OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
EXTERNAL_OSRM_BIKE_URL=https://routing.openstreetmap.de/routed-bike
EXTERNAL_FALLBACK_ENABLED=true
EXTERNAL_FALLBACK_ON_EMPTY=false
EXTERNAL_FALLBACK_ON_ERROR=false
OSM_PBF_URL=https://download.geofabrik.de/asia/japan/kanto-latest.osm.pbf
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:v5.27.1

# Read-only snapshot (takes precedence over DATABASE_URL)
LOCAL_PLACES_SQLITE=
LOCAL_OSRM_AUTH=false
PLACES_SNAPSHOT_URI=
