project_id = "your-geo-home-project-id"
region     = "asia-northeast1"

# Replace * with the GemiHub Business and Codex web origins in production.
cors_origins = ["*"]
public_tiles = true

# Leave empty for the built-in demo, then set these after uploading data.
land_price_object    = ""
pmtiles_object       = "land-price.pmtiles"
pmtiles_source_layer = "land-price"

# Shared secret for /mcp. Generate with: openssl rand -hex 32
# Every client (kakeratta, Agent Plugins) sends it as Authorization: Bearer <key>.
mcp_api_key = ""
