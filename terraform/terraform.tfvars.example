project_id = "your-geo-home-project-id"
region = "asia-northeast1"
domain = "geo.example.com"
# Generate a secret with: openssl rand -hex 32
mcp_api_key = ""
# Build with cloudbuild-serverless.yaml, then use its build ID.
serverless_image_tag = "YOUR_BUILD_ID"
# Leave empty to use serverless_image_tag for the updater as well.
update_image_tag = ""
# Initial deployment: immutable release already uploaded to the snapshot bucket.
# After current.json exists, leave empty to follow successful weekly publications.
snapshot_release = ""
enable_weekly_update = false
